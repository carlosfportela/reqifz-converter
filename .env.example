# .env.example — Template de variáveis de ambiente
#
# Copie este arquivo para .env e ajuste os valores para seu ambiente local.
# O arquivo .env NÃO deve ser commitado no repositório (já está no .gitignore).
#
# Em produção (OpenShift), configure estas variáveis diretamente no deployment
# como "Environment Variables" ou via "Secret" para valores sensíveis.

# ---------------------------------------------------------------------------
# Ambiente de execução
# Valores: development | production
# development → Flask dev server com debug e hot-reload (python app.py)
# production  → Requer Gunicorn (Linux) ou Waitress (Windows)
# ---------------------------------------------------------------------------
FLASK_ENV=development

# ---------------------------------------------------------------------------
# Servidor
# PORT: porta de escuta
#   - Desenvolvimento (Flask): 5000
#   - Produção local (Waitress): 8080
#   - OpenShift: 8080 (padrão do platform, normalmente não precisa definir)
# ---------------------------------------------------------------------------
PORT=5000

# ---------------------------------------------------------------------------
# Gunicorn (OpenShift/Linux) — ignorado no Windows
# WEB_CONCURRENCY: número de worker processes (padrão: 2×CPUs + 1)
# GUNICORN_THREADS: threads por worker (padrão: 4)
# GUNICORN_TIMEOUT: timeout por requisição em segundos (padrão: 600)
# LOG_LEVEL: debug | info | warning | error (padrão: info)
# ---------------------------------------------------------------------------
WEB_CONCURRENCY=3
GUNICORN_THREADS=4
GUNICORN_TIMEOUT=600
LOG_LEVEL=info
